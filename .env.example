# Configuration Autome (F1.6) — copier en `.env` (ignoré par Git) et adapter.
# Source unique : variables d'environnement. Défauts par profil ; en `prod`
# les secrets sont OBLIGATOIRES et non-défaut (sinon échec au démarrage).

# Profil d'exécution : dev | prod  (défaut : dev)
APP_PROFILE=dev

# Adresse d'écoute HTTP de l'API.
#   défaut dev  : 127.0.0.1:8080
#   défaut prod : 0.0.0.0:8080
APP_HTTP_ADDR=127.0.0.1:8080

# PostgreSQL (schéma : migrations/ — F1.5).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/autome

# File de messages RabbitMQ, lue avec AUTOME_QUEUE=rabbitmq. Le chemin est le
# vhost : `/%2f` pour le vhost par défaut `/` (une barre finale seule = vhost
# vide, refusé par le broker). Ex. amqp://guest:guest@localhost:5672/%2f
QUEUE_URL=

# --- Backends (API + worker) ---------------------------------------------
# Stores : memory (défaut, process seul, perdu au redémarrage) | postgres.
# File   : memory (défaut, invisible des autres process)       | rabbitmq.
# En APP_PROFILE=prod, `memory` est REFUSÉ au démarrage (API et worker).
#AUTOME_PERSISTENCE=postgres
#AUTOME_QUEUE=rabbitmq
# Délai (s) pendant lequel la connexion au broker est retentée au démarrage :
#AUTOME_QUEUE_CONNECT_TIMEOUT_SECS=60
# Migrations appliquées par l'API au démarrage (mode postgres) :
#AUTOME_MIGRATE=true

# --- CORS (#225) -------------------------------------------------------------
# Origines du frontend autorisées à appeler l'API (scheme://hôte[:port],
# séparées par des virgules, sans joker). Défaut : http://localhost:5173 et
# http://localhost:8081 en dev, aucune en prod. Vide = aucune.
#AUTOME_CORS_ORIGINS=https://autome.example.com

# --- Logs (API + worker) ---------------------------------------------------
# Format : json (défaut en prod, une ligne JSON par événement) | text (défaut
# en dev). Niveau : syntaxe RUST_LOG (défaut info).
#AUTOME_LOG_FORMAT=json
#RUST_LOG=info,autome_worker=debug

# --- Worker ---------------------------------------------------------------
# Tâches consommatrices par process (défaut 4).
#AUTOME_WORKER_CONCURRENCY=4
# Un run est exécuté AU PLUS UNE FOIS (claim atomique en base). Au-delà de ce
# délai (secondes, défaut 3600, minimum 60), une tentative toujours `running`
# est close en `failed`. À régler au-dessus de la durée du plus long run.
#AUTOME_RUN_TIMEOUT_SECS=3600
# Bail d'un run en cours (#239, secondes, défaut 60, minimum 10) : le worker
# bat tous les quarts de bail ; un run sans battement depuis ce délai (worker
# tué) est remis en file et repris à son point de reprise par un autre worker.
#AUTOME_RUN_LEASE_SECS=60
# Déclencheurs planifiés (#227) : période de la boucle des nœuds `schedule`
# (cron UTC / intervalle) et `polling`, en secondes (défaut 10, 0 = désactivée).
# Chaque réplique la fait tourner ; une échéance n'est déclenchée qu'une fois
# (coordination en base, PostgreSQL requis).
#AUTOME_SCHEDULER_TICK_SECS=10

# --- Secrets (NE JAMAIS committer de vraie valeur) -----------------------
# Signature des JWT (usage : F6.1).
JWT_SECRET=dev-insecure-jwt-secret
# Chiffrement des credentials au repos (usage : F6.3). L'API (qui chiffre les
# tokens OAuth des connecteurs) et le worker (qui les déchiffre) doivent
# recevoir la MÊME valeur.
ENCRYPTION_KEY=dev-insecure-encryption-key

# --- Tokens des connecteurs (Slack/Gmail/Notion/GitHub) -------------------
# Par défaut (`per_user`), chaque action de connecteur utilise le token OAuth
# du PROPRIÉTAIRE du run, connecté via /credentials/<provider>/authorize et
# stocké chiffré (table `connector_tokens` avec AUTOME_PERSISTENCE=postgres).
# Pas de token pour ce propriétaire → le node échoue (aucun token d'autrui).
#
# `single_tenant` : opt-in d'opérateur pour une instance MONO-TENANT — repli
# sur un token GLOBAL par provider (AUTOME_CONNECTOR_TOKEN_<PROVIDER>), utilisé
# par TOUS les utilisateurs qui n'ont pas connecté le leur. À ne pas activer
# sur une instance partagée.
#AUTOME_CONNECTOR_CREDENTIALS=single_tenant
#AUTOME_CONNECTOR_TOKEN_SLACK=xoxb-REPLACE_ME
#AUTOME_CONNECTOR_TOKEN_GITHUB=ghp_REPLACE_ME

# --- Sortie réseau (anti-SSRF) -------------------------------------------
# Les requêtes HTTP sortantes (action `http_request`, OAuth) ne visent que des
# adresses PUBLIQUES : localhost, réseaux privés, link-local (169.254.x.x,
# métadonnées cloud)… sont refusés. HTTP(S)_PROXY / ALL_PROXY sont ignorés
# par ces requêtes (le proxy contournerait le filtre) : sortie en direct, ou
# via une passerelle transparente. Hôtes internes légitimes à exempter
# (noms ou IP, séparés par virgule) :
#AUTOME_EGRESS_ALLOWLIST=keycloak.internal,10.0.0.12

# --- Providers OAuth (#161) ----------------------------------------------
# Liste des providers à activer (séparés par virgule). Vide = OAuth désactivé.
# Pour chaque <ID>, définir les variables AUTOME_OAUTH_<ID>_* ci-dessous
# (<ID> = provider_id en MAJUSCULES, tirets → underscores). Un champ requis
# manquant pour un provider listé fait échouer le démarrage (fail-fast).
# À définir sur l'API ET sur le worker : le worker s'en sert pour rafraîchir
# les access tokens expirés (refresh token stocké) avant d'exécuter un node.
# Le worker cherche le token sous le provider_id = préfixe de l'action :
# `slack`, `gmail`, `notion`, `github` (ex. `gmail` et non `google` pour les
# actions gmail.*).
#AUTOME_OAUTH_PROVIDERS=google,github
#
#AUTOME_OAUTH_GOOGLE_CLIENT_ID=REPLACE_ME
#AUTOME_OAUTH_GOOGLE_CLIENT_SECRET=REPLACE_ME
#AUTOME_OAUTH_GOOGLE_AUTHORIZE_URL=https://accounts.google.com/o/oauth2/v2/auth
#AUTOME_OAUTH_GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
#AUTOME_OAUTH_GOOGLE_REDIRECT_URI=https://app.autome/oauth/callback/google
#AUTOME_OAUTH_GOOGLE_SCOPES=openid,email,profile
#
#AUTOME_OAUTH_GITHUB_CLIENT_ID=REPLACE_ME
#AUTOME_OAUTH_GITHUB_CLIENT_SECRET=REPLACE_ME
#AUTOME_OAUTH_GITHUB_AUTHORIZE_URL=https://github.com/login/oauth/authorize
#AUTOME_OAUTH_GITHUB_TOKEN_URL=https://github.com/login/oauth/access_token
#AUTOME_OAUTH_GITHUB_REDIRECT_URI=https://app.autome/oauth/callback/github
#AUTOME_OAUTH_GITHUB_SCOPES=repo,read:user

# --- Arrêt borné du worker (#200, #239) ---
# Sur SIGTERM : plus de nouveaux runs, chaque run en cours s'arrête au
# prochain nœud et est remis en file. Délai laissé à un nœud long (secondes) ;
# au-delà, son run est remis en file en plein nœud (rejoué seulement si le
# nœud est rejouable). La période de grâce de l'orchestrateur doit le dépasser
# d'une dizaine de secondes.
#AUTOME_WORKER_SHUTDOWN_TIMEOUT_SECS=25

# --- Arrêt gracieux de l'API (#194) ---
# Sur SIGTERM : readiness à 503 pendant le délai de retrait, puis drain des
# requêtes en cours borné (secondes). La période de grâce de l'orchestrateur
# doit dépasser leur somme.
#AUTOME_SHUTDOWN_DELAY_SECS=5
#AUTOME_SHUTDOWN_TIMEOUT_SECS=20

# --- Déclencheurs webhook (#202) ---
# Requêtes acceptées par URL de webhook et par fenêtre de 15 min (≥ 1).
#AUTOME_WEBHOOK_MAX_PER_WINDOW=1000

# --- Anti-bruteforce par adresse IP (#190) ---
# Quotas par IP cliente et par fenêtre de 15 min (0 = désactivé) : échecs de
# connexion (une connexion réussie ne compte pas) et tentatives d'inscription.
#AUTOME_LOGIN_IP_MAX_ATTEMPTS=50
#AUTOME_SIGNUP_IP_MAX_ATTEMPTS=10
# Demandes de réinitialisation du mot de passe par IP (#204).
#AUTOME_RESET_IP_MAX_ATTEMPTS=10
# Renvois du lien de vérification de l'email par IP (#231).
#AUTOME_VERIFY_IP_MAX_ATTEMPTS=10
# Proxys (CIDR ou adresses) dont on croit l'en-tête X-Forwarded-For. Vide =
# l'adresse du pair TCP fait foi (API exposée directement, comme en compose).
#AUTOME_TRUSTED_PROXIES=10.0.0.0/8

# --- Envoi d'emails : mot de passe oublié (#204), vérification (#231), invitations (#241) ---
# Relais SMTP : smtps://user:pass@hôte (TLS implicite, 465) ou
# smtp://user:pass@hôte:587?tls=required (STARTTLS). Sans SMTP : en dev le lien
# de réinitialisation est écrit dans les journaux de l'API ; en prod la
# fonction est désactivée (503).
#AUTOME_SMTP_URL=smtps://user:password@smtp.example.com
#AUTOME_MAIL_FROM=Autome <no-reply@example.com>
# URL publique du frontend, base des liens envoyés (obligatoire avec SMTP en prod).
#AUTOME_PUBLIC_URL=https://autome.example.com
# Vérification de l'email à l'inscription (#231) : `required` (défaut) — la
# connexion attend l'ouverture du lien reçu, dès qu'un envoi d'email est
# possible (en dev sans SMTP : lien dans les journaux) — ou `off`.
#AUTOME_EMAIL_VERIFICATION=required
# Inscriptions publiques (#241) : `open` (défaut) ou `invite_only` — les
# comptes ne naissent alors que par invitation d'un administrateur
# (onglet Administration, ou `autome-api invite <email> admin` pour le premier).
#AUTOME_SIGNUP=open
