{
  "openapi": "3.1.0",
  "info": {
    "title": "Autome API",
    "description": "Backend HTTP du moteur d'automatisation Autome.",
    "contact": {
      "name": "Équipe Autome"
    },
    "license": {
      "name": "MIT",
      "identifier": "MIT"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "`POST /auth/login` — échange email + mot de passe contre une paire de jetons.",
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CredentialsBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Connecté",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "401": {
            "description": "Identifiants invalides"
          },
          "429": {
            "description": "Trop d'échecs (compte ou adresse IP) — voir `Retry-After`"
          }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "`POST /auth/logout` — ferme la session côté serveur.",
        "description": "Révoque le refresh présenté (plus de rotation possible) et, s'il est fourni\nen `Authorization: Bearer`, l'access token **du même utilisateur** (refusé\npartout jusqu'à son expiration). Idempotent : un refresh déjà révoqué\nrépond aussi 204. Un Bearer absent, invalide ou d'un autre utilisateur\nn'empêche pas la déconnexion : il est simplement ignoré.",
        "operationId": "logout",
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "description": "`Bearer <access_token>` de la session, révoqué aussi s'il est fourni",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Session fermée (ou déjà fermée)"
          },
          "401": {
            "description": "Refresh invalide ou expiré"
          }
        }
      }
    },
    "/auth/logout-all": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "`POST /auth/logout-all` — ferme toutes les sessions de l'utilisateur\nauthentifié, sur tous les appareils, y compris celle de la requête.",
        "description": "Incrémente sa version de session : tous ses access et refresh tokens émis\njusqu'ici sont refusés (401) ; une nouvelle connexion ouvre une session\nvalide. Réponse 204.",
        "operationId": "logout_all",
        "responses": {
          "204": {
            "description": "Toutes les sessions sont fermées"
          },
          "401": {
            "description": "Access token absent, invalide ou déjà révoqué"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/auth/refresh": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "`POST /auth/refresh` — rotation : le refresh présenté est révoqué et une\nnouvelle paire est émise. Un refresh déjà utilisé est refusé (rejeu).",
        "operationId": "refresh",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Nouvelle paire",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "401": {
            "description": "Refresh invalide, expiré ou déjà utilisé"
          }
        }
      }
    },
    "/auth/signup": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "`POST /auth/signup` — crée un compte (rôle `editor`) et le connecte.",
        "operationId": "signup",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CredentialsBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Compte créé",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "400": {
            "description": "Email ou mot de passe invalide"
          },
          "409": {
            "description": "Email déjà enregistré"
          },
          "429": {
            "description": "Trop d'inscriptions depuis cette adresse — voir `Retry-After`"
          }
        }
      }
    },
    "/credentials": {
      "get": {
        "tags": [
          "credentials"
        ],
        "summary": "`GET /credentials` — résumé des credentials de l'utilisateur courant.",
        "operationId": "list_credentials",
        "responses": {
          "200": {
            "description": "Credentials de l'utilisateur (sans tokens bruts)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListCredentialsResponse"
                }
              }
            }
          },
          "401": {
            "description": "Token absent ou invalide"
          },
          "403": {
            "description": "Manque `credentials.manage`"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/credentials/providers": {
      "get": {
        "tags": [
          "credentials"
        ],
        "summary": "`GET /credentials/providers` — liste les providers OAuth.",
        "operationId": "list_providers",
        "responses": {
          "200": {
            "description": "Providers OAuth déclarés (sans `client_secret`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListProvidersResponse"
                }
              }
            }
          },
          "401": {
            "description": "Token absent ou invalide"
          },
          "403": {
            "description": "Manque `credentials.manage`"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/credentials/{provider}": {
      "delete": {
        "tags": [
          "credentials"
        ],
        "summary": "`DELETE /credentials/{provider}` — révoque un credential.",
        "operationId": "delete_credential",
        "parameters": [
          {
            "name": "provider",
            "in": "path",
            "description": "Identifiant du provider OAuth",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Révoqué (idempotent)"
          },
          "401": {
            "description": "Token absent ou invalide"
          },
          "403": {
            "description": "Manque `credentials.manage`"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/credentials/{provider}/authorize": {
      "post": {
        "tags": [
          "credentials"
        ],
        "summary": "`POST /credentials/{provider}/authorize` — démarre un flow OAuth.",
        "operationId": "start_authorize",
        "parameters": [
          {
            "name": "provider",
            "in": "path",
            "description": "Identifiant du provider OAuth",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "URL d'autorisation + PKCE",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthorizeResponse"
                }
              }
            }
          },
          "401": {
            "description": "Token absent ou invalide"
          },
          "403": {
            "description": "Manque `credentials.manage`"
          },
          "404": {
            "description": "Provider inconnu"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/credentials/{provider}/callback": {
      "post": {
        "tags": [
          "credentials"
        ],
        "summary": "`POST /credentials/{provider}/callback` — échange `code` → tokens.",
        "operationId": "complete_authorize",
        "parameters": [
          {
            "name": "provider",
            "in": "path",
            "description": "Identifiant du provider OAuth",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "description": "`code` + `state` + `code_verifier` du callback OAuth",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CallbackBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Tokens persistés (chiffrés) — résumé safe",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CredentialDto"
                }
              }
            }
          },
          "401": {
            "description": "Token absent ou invalide"
          },
          "403": {
            "description": "Manque `credentials.manage`"
          },
          "502": {
            "description": "Échec OAuth en amont (rejet du provider)"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/livez": {
      "get": {
        "tags": [
          "probes"
        ],
        "summary": "`GET /livez` — le process répond (aucune dépendance vérifiée).",
        "operationId": "livez",
        "responses": {
          "200": {
            "description": "Vivant",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "tags": [
          "probes"
        ],
        "summary": "`GET /readyz` — prêt à servir : PostgreSQL et broker joignables.",
        "operationId": "readyz",
        "responses": {
          "200": {
            "description": "Prêt",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyzResponse"
                }
              }
            }
          },
          "503": {
            "description": "Une dépendance au moins est indisponible",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyzResponse"
                }
              }
            }
          }
        }
      }
    },
    "/runs/{run_id}": {
      "get": {
        "tags": [
          "runs"
        ],
        "summary": "`GET /runs/{run_id}` — détail d'un run (perm `runs.read`).",
        "operationId": "get_run",
        "parameters": [
          {
            "name": "run_id",
            "in": "path",
            "description": "Identifiant du run",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Détail du run",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "401": {
            "description": "Token absent ou invalide"
          },
          "403": {
            "description": "Manque `runs.read`"
          },
          "404": {
            "description": "Run inconnu"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/workflows": {
      "get": {
        "tags": [
          "workflows"
        ],
        "summary": "`GET /workflows?offset=&limit=` — liste paginée (perm `workflows.read`).",
        "operationId": "list_workflows",
        "parameters": [
          {
            "name": "offset",
            "in": "query",
            "description": "Offset, défaut 0.",
            "required": false,
            "schema": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Limite, défaut 50.",
            "required": false,
            "schema": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
          },
          {
            "name": "owner",
            "in": "query",
            "description": "Espace d'un autre utilisateur (super-admin seulement) — cf.\n[`NamespaceQuery`].",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Page de workflows",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListResponse"
                }
              }
            }
          },
          "401": {
            "description": "Token absent ou invalide"
          },
          "403": {
            "description": "Manque `workflows.read`, ou `owner` d'autrui sans `*`"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      },
      "post": {
        "tags": [
          "workflows"
        ],
        "summary": "`POST /workflows` — création (201 Created, perm `workflows.write`) dans\nl'espace de l'appelant (ou `?owner=` pour un super-admin).",
        "operationId": "create_workflow",
        "parameters": [
          {
            "name": "owner",
            "in": "query",
            "description": "Propriétaire de l'espace visé.",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        ],
        "requestBody": {
          "description": "Workflow graph complet",
          "content": {
            "application/json": {
              "schema": {}
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Créé",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "401": {
            "description": "Token absent ou invalide"
          },
          "403": {
            "description": "Manque `workflows.write`, ou `owner` d'autrui sans `*`"
          },
          "409": {
            "description": "Id déjà utilisé dans cet espace"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/workflows/{id}": {
      "get": {
        "tags": [
          "workflows"
        ],
        "summary": "`GET /workflows/{id}` — détail (perm `workflows.read`).",
        "operationId": "get_workflow",
        "parameters": [
          {
            "name": "id",
