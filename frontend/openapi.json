                "string",
                "null"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Page de runs (plus récent en premier)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListRunsResponse"
                }
              }
            }
          },
          "401": {
            "description": "Token absent ou invalide"
          },
          "403": {
            "description": "Manque `runs.read`, ou `owner` d'autrui sans `*`"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      },
      "post": {
        "tags": [
          "runs"
        ],
        "summary": "`POST /workflows/{id}/runs` — démarre un run (perm `runs.execute`).",
        "operationId": "create_run",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Identifiant du workflow à exécuter",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "owner",
            "in": "query",
            "description": "Propriétaire de l'espace visé.",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        ],
        "requestBody": {
          "description": "Payload initial + version optionnelle",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateRunBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Run accepté en queue",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateRunResponse"
                }
              }
            }
          },
          "401": {
            "description": "Token absent ou invalide"
          },
          "403": {
            "description": "Manque `runs.execute`, ou `owner` d'autrui sans `*`"
          },
          "404": {
            "description": "Workflow inconnu dans cet espace"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "AuthorizeResponse": {
        "type": "object",
        "description": "Réponse de `POST /credentials/{provider}/authorize` (PKCE côté SPA :\nle caller conserve `state` + `code_verifier` jusqu'au callback).",
        "required": [
          "authorize_url",
          "state",
          "code_verifier"
        ],
        "properties": {
          "authorize_url": {
            "type": "string",
            "description": "URL absolue où rediriger l'utilisateur."
          },
          "code_verifier": {
            "type": "string",
            "description": "PKCE verifier — à reposter à `/callback`."
          },
          "state": {
            "type": "string",
            "description": "Paramètre `state` (anti-CSRF) à comparer dans le callback."
          }
        }
      },
      "CallbackBody": {
        "type": "object",
        "description": "Body de `POST /credentials/{provider}/callback`.",
        "required": [
          "code",
          "state",
          "code_verifier"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "`code` retourné par le provider à l'utilisateur."
          },
          "code_verifier": {
            "type": "string",
            "description": "PKCE verifier que le caller a conservé entre `/authorize` et ici."
          },
          "state": {
            "type": "string",
            "description": "`state` retourné par le provider — anti-CSRF, identique à\ncelui renvoyé par `/authorize`."
          }
        }
      },
      "CreateRunBody": {
        "type": "object",
