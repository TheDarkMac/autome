              "type": "string"
            }
          },
          {
            "name": "owner",
            "in": "query",
            "description": "Propriétaire de l'espace visé.",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Détail",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "401": {
            "description": "Token absent ou invalide"
          },
          "403": {
            "description": "Manque `workflows.read`, ou `owner` d'autrui sans `*`"
          },
          "404": {
            "description": "Workflow inconnu dans cet espace"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      },
      "put": {
        "tags": [
          "workflows"
        ],
        "summary": "`PUT /workflows/{id}` — remplacement complet (perm `workflows.write`).\nL'`id` du path doit correspondre à celui dans le body.",
        "operationId": "update_workflow",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Identifiant du workflow",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "owner",
            "in": "query",
            "description": "Propriétaire de l'espace visé.",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        ],
        "requestBody": {
          "description": "Workflow graph complet",
          "content": {
            "application/json": {
              "schema": {}
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Remplacé",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "400": {
            "description": "id path ≠ id body"
          },
          "401": {
            "description": "Token absent ou invalide"
          },
          "403": {
            "description": "Manque `workflows.write`, ou `owner` d'autrui sans `*`"
          },
          "404": {
            "description": "Workflow inconnu dans cet espace"
          }
        },
        "security": [
          {
            "bearer": []
          }
