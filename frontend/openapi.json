              ],
              "minimum": 0
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Limite, défaut 50.",
            "required": false,
            "schema": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            }
