      "delete": {
        "tags": [
          "workflows"
        ],
        "summary": "`DELETE /workflows/{id}` — suppression (204, idempotent, perm `workflows.write`).",
        "operationId": "delete_workflow",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Identifiant du workflow",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "owner",
            "in": "query",
            "description": "Propriétaire de l'espace visé.",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Supprimé (idempotent)"
          },
          "401": {
            "description": "Token absent ou invalide"
          },
          "403": {
            "description": "Manque `workflows.write`, ou `owner` d'autrui sans `*`"
          }
        },
        "security": [
          {
            "bearer": []
          }
